@model IEnumerable<RefugioAnimal.Web.ViewModels.Mascota.MascotaViewModel>

@{
    ViewBag.Title = "Mascotas";
}

<div class="page-header">
    <h1 class="h2">Mascotas</h1>

    @if (User.IsInRole("Administrador"))
    {
        @Html.ActionLink(
            "Nueva mascota",
            "Crear",
            null,
            new { @class = "btn btn-primary" })
    }
</div>

@if (!Model.Any())
{
    @Html.Partial("_EstadoVacio", new ViewDataDictionary {
        { "Titulo", "Aún no hay mascotas registradas" },
        { "Mensaje", "Registre la primera mascota para comenzar a gestionar el refugio." },
        { "AccionTexto", "Nueva mascota" },
        { "Accion", "Crear" },
        { "Controlador", "Mascotas" }
    })
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Especie</th>
                    <th>Raza</th>
                    <th>Sexo</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var mascota in Model)
                {
                    <tr>
                        <td>@mascota.Nombre</td>
                        <td>@mascota.Especie</td>
                        <td>@mascota.Raza</td>
                        <td>@mascota.Sexo</td>
                        <td>@mascota.Estado</td>

                        <td>
                            @Html.ActionLink(
                                "Ver",
                                "Detalle",
                                new { id = mascota.Id },
                                new { @class = "btn btn-outline-primary btn-sm" })

                            @if (User.IsInRole("Administrador"))
                            {
                                @Html.ActionLink(
                                    "Editar",
                                    "Editar",
                                    new { id = mascota.Id },
                                    new { @class = "btn btn-outline-secondary btn-sm" })

                                @Html.ActionLink(
                                    "Eliminar",
                                    "Eliminar",
                                    new { id = mascota.Id },
                                    new { @class = "btn btn-outline-danger btn-sm" })
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}