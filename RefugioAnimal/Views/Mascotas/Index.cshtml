
@model IEnumerable<RefugioAnimal.Web.ViewModels.Mascota.MascotaViewModel>

@{
    ViewBag.Title = "Mascotas";
}

<div class="page-header">
    <h1 class="h2">Mascotas</h1>
    @Html.ActionLink("Nueva mascota", "Crear", null, new { @class = "btn btn-primary" })
</div>

@if (!Model.Any())
{
    @Html.Partial("_EstadoVacio", new ViewDataDictionary {
        { "Titulo", "Aún no hay mascotas registradas" },
        { "Mensaje", "Registre la primera mascota para comenzar a gestionar el refugio." },
        { "AccionTexto", "Nueva mascota" },
        { "Accion", "Crear" },
        { "Controlador", "Mascotas" }
    })
}
else
{
    <div class="card card-heroverse">
        <div class="table-responsive">
            <table class="table table-hover table-heroverse mb-0">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Especie</th>
                        <th>Raza</th>
                        <th>Sexo</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var mascota in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@mascota.Nombre</td>
                            <td>@mascota.Especie</td>
                            <td>@mascota.Raza</td>
                            <td>@mascota.Sexo</td>
                            <td>@mascota.Estado</td>
                            <td class="text-end acciones">
                                @Html.ActionLink("Ver", "Detalle", new { id = mascota.Id }, new { @class = "btn btn-sm btn-outline-primary" })
                                @Html.ActionLink("Editar", "Editar", new { id = mascota.Id }, new { @class = "btn btn-sm btn-outline-secondary" })
                                @Html.ActionLink("Eliminar", "Eliminar", new { id = mascota.Id }, new { @class = "btn btn-sm btn-outline-danger" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}