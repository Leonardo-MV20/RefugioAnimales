
@model RefugioAnimal.Web.ViewModels.Mascota.MascotaFormModelBase

<div class="mb-3">
    @Html.LabelFor(m => m.Nombre, new { @class = "form-label" })
    @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", maxlength = 100, autocomplete = "off" })
    @Html.ValidationMessageFor(m => m.Nombre)
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        @Html.LabelFor(m => m.Especie, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Especie, new { @class = "form-control", maxlength = 50, autocomplete = "off" })
        @Html.ValidationMessageFor(m => m.Especie)
    </div>

    <div class="col-md-6 mb-3">
        @Html.LabelFor(m => m.Raza, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Raza, new { @class = "form-control", maxlength = 100, autocomplete = "off" })
        @Html.ValidationMessageFor(m => m.Raza)
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        @Html.LabelFor(m => m.EdadAproximada, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.EdadAproximada, new { @class = "form-control", autocomplete = "off" })
        @Html.ValidationMessageFor(m => m.EdadAproximada)
    </div>

    <div class="col-md-6 mb-3">
        @Html.LabelFor(m => m.Sexo, new { @class = "form-label" })

        @Html.DropDownListFor(
            m => m.Sexo,
            new List<SelectListItem>
            {
                new SelectListItem { Text = "Macho", Value = "Macho" },
                new SelectListItem { Text = "Hembra", Value = "Hembra" }
            },
            "-- Seleccione el sexo --",
            new { @class = "form-select" })

        @Html.ValidationMessageFor(m => m.Sexo)
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        @Html.LabelFor(m => m.Estado, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Estado, new { @class = "form-control", maxlength = 30, autocomplete = "off" })
        @Html.ValidationMessageFor(m => m.Estado)
    </div>

    <div class="col-md-6 mb-3">
        @Html.LabelFor(m => m.FechaIngreso, new { @class = "form-label" })
        @Html.TextBoxFor(
            m => m.FechaIngreso,
            "{0:yyyy-MM-dd}",
            new { @class = "form-control", type = "date" })
        @Html.ValidationMessageFor(m => m.FechaIngreso)
    </div>
</div>

<div class="mb-3">
    @Html.LabelFor(m => m.Descripcion, new { @class = "form-label" })
    @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", maxlength = 500, rows = 4 })
    @Html.ValidationMessageFor(m => m.Descripcion)
</div>

<div class="form-check form-switch mb-4">
    @Html.CheckBoxFor(m => m.EstaActivo, new { @class = "form-check-input", role = "switch" })
    @Html.LabelFor(m => m.EstaActivo, new { @class = "form-check-label" })
    <div class="form-text">Indica si la mascota se encuentra activa dentro del refugio.</div>
</div>