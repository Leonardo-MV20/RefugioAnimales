
@model RefugioAnimal.Web.ViewModels.Mascota.MascotaViewModel

@{
    ViewBag.Title = "Eliminar mascota";
}

<div class="page-header">
    <h1 class="h2">Eliminar mascota</h1>
</div>

<div class="card">
    <div class="card-body p-4">

        <div class="alert alert-warning" role="alert">
            ¿Está seguro de que desea eliminar esta mascota? Esta acción no se puede deshacer.
        </div>

        <dl class="row detalle mb-4">

            <dt class="col-sm-4">Nombre</dt>
            <dd class="col-sm-8">@Model.Nombre</dd>

            <dt class="col-sm-4">Especie</dt>
            <dd class="col-sm-8">@Model.Especie</dd>

            <dt class="col-sm-4">Raza</dt>
            <dd class="col-sm-8">@Model.Raza</dd>

            <dt class="col-sm-4">Estado</dt>
            <dd class="col-sm-8">@Model.Estado</dd>

        </dl>

        @using (Html.BeginForm("ConfirmarEliminar", "Mascotas", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-danger">Eliminar</button>

                @Html.ActionLink(
                    "Cancelar",
                    "Index",
                    null,
                    new { @class = "btn btn-secondary" })
            </div>
        }

    </div>
</div>
