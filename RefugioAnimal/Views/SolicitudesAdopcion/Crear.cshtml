
@model RefugioAnimal.Web.ViewModels.SolicitudAdopcion.CrearSolicitudAdopcionFormModel

@{
    ViewBag.Title = "Registrar solicitud de adopción";
}

<h2>Registrar solicitud de adopción</h2>

@using (Html.BeginForm(
    "Crear",
    "SolicitudesAdopcion",
    FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(
        true,
        "",
        new { @class = "text-danger" })

    @Html.Partial("_CamposSolicitudAdopcion", Model)

    <button type="submit" class="btn btn-primary">
        Guardar
    </button>

    @Html.ActionLink(
        "Cancelar",
        "Index",
        null,
        new { @class = "btn btn-secondary" })
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}