
@model RefugioAnimal.Web.Models.Account.RegistroViewModel

@{
    ViewBag.Title = "Crear cuenta";
}

<h2>Crear cuenta</h2>

@using (Html.BeginForm("Registro", "Account", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="mb-3">
        @Html.LabelFor(m => m.Correo, new { @class = "form-label" })

        @Html.TextBoxFor(
            m => m.Correo,
            new
            {
                @class = "form-control",
                type = "email",
                autocomplete = "email"
            })

        @Html.ValidationMessageFor(
            m => m.Correo,
            "",
            new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Password, new { @class = "form-label" })

        @Html.PasswordFor(
            m => m.Password,
            new
            {
                @class = "form-control",
                autocomplete = "new-password"
            })

        @Html.ValidationMessageFor(
            m => m.Password,
            "",
            new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.ConfirmarPassword, new { @class = "form-label" })

        @Html.PasswordFor(
            m => m.ConfirmarPassword,
            new
            {
                @class = "form-control",
                autocomplete = "new-password"
            })

        @Html.ValidationMessageFor(
            m => m.ConfirmarPassword,
            "",
            new { @class = "text-danger" })
    </div>

    <button type="submit" class="btn btn-primary">
        Registrarme
    </button>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}