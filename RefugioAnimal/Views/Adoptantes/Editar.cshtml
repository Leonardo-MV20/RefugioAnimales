@model RefugioAnimal.Web.ViewModels.Adoptante.EditarAdoptanteFormModel

@{
    ViewBag.Title = "Editar adoptante";
}

<h2>Editar adoptante</h2>

@using (Html.BeginForm(
    "Editar",
    "Adoptantes",
    new { id = Model.Id },
    FormMethod.Post,
    null))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(m => m.Id)

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    @Html.Partial("_CamposAdoptante", Model)

    <button type="submit" class="btn btn-primary">
        Guardar cambios
    </button>

    @Html.ActionLink(
            "Cancelar",
            "Index",
            null,
            new { @class = "btn btn-secondary" })
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}