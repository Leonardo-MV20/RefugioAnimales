
@model RefugioAnimal.Web.ViewModels.Adoptante.AdoptanteFormModelBase

<div class="mb-3">
    @Html.LabelFor(m => m.NombreCompleto, new { @class = "form-label" })
    @Html.TextBoxFor(m => m.NombreCompleto, new { @class = "form-control" })
    @Html.ValidationMessageFor(m => m.NombreCompleto, "", new { @class = "text-danger" })
</div>

<div class="mb-3">
    @Html.LabelFor(m => m.Identificacion, new { @class = "form-label" })
    @Html.TextBoxFor(m => m.Identificacion, new { @class = "form-control" })
    @Html.ValidationMessageFor(m => m.Identificacion, "", new { @class = "text-danger" })
</div>

<div class="mb-3">
    @Html.LabelFor(m => m.Telefono, new { @class = "form-label" })
    @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control" })
    @Html.ValidationMessageFor(m => m.Telefono, "", new { @class = "text-danger" })
</div>

<div class="mb-3">
    @Html.LabelFor(m => m.Correo, new { @class = "form-label" })
    @Html.TextBoxFor(
        m => m.Correo,
        new
        {
            @class = "form-control",
            type = "email"
        })
    @Html.ValidationMessageFor(m => m.Correo, "", new { @class = "text-danger" })
</div>

<div class="mb-3">
    @Html.LabelFor(m => m.Direccion, new { @class = "form-label" })
    @Html.TextAreaFor(
        m => m.Direccion,
        new
        {
            @class = "form-control",
            rows = "3"
        })
    @Html.ValidationMessageFor(m => m.Direccion, "", new { @class = "text-danger" })
</div>

<div class="mb-3">
    @Html.LabelFor(m => m.Observaciones, new { @class = "form-label" })
    @Html.TextAreaFor(
        m => m.Observaciones,
        new
        {
            @class = "form-control",
            rows = "4"
        })
    @Html.ValidationMessageFor(m => m.Observaciones, "", new { @class = "text-danger" })
</div>