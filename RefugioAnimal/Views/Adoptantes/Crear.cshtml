
@model RefugioAnimal.Web.ViewModels.Adoptante.CrearAdoptanteFormModel

@{
    ViewBag.Title = "Registrar adoptante";
}

<h2>Registrar adoptante</h2>

@using (Html.BeginForm("Crear", "Adoptantes", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    @Html.Partial("_CamposAdoptante", Model)

    <button type="submit" class="btn btn-primary">
        Guardar
    </button>

    @Html.ActionLink(
        "Cancelar",
        "Index",
        null,
        new { @class = "btn btn-secondary" })
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}