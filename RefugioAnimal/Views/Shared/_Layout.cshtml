@{
    var controlador = (ViewContext.RouteData.Values["controller"] ?? "").ToString();

    Func<string, string> activo = c =>
        string.Equals(controlador, c, StringComparison.OrdinalIgnoreCase) ? " active" : "";
}

<!DOCTYPE html>

<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewBag.Title - Refugio de Animales</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>

<body class="d-flex flex-column min-vh-100">

    <nav class="navbar navbar-expand-md navbar-dark bg-dark">
        <div class="container">

            @Html.ActionLink(
                "Refugio de Animales",
                "Index",
                "Home",
                new { area = "" },
                new { @class = "navbar-brand fw-bold" })

            <button type="button"
                    class="navbar-toggler"
                    data-bs-toggle="collapse"
                    data-bs-target="#menuPrincipal"
                    aria-controls="menuPrincipal"
                    aria-expanded="false"
                    aria-label="Mostrar u ocultar el menú">

                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menuPrincipal">

                <ul class="navbar-nav me-auto mb-2 mb-md-0">

                    <li class="nav-item">
                        @Html.ActionLink(
                            "Inicio",
                            "Index",
                            "Home",
                            new { area = "" },
                            new { @class = "nav-link" + activo("Home") })
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink(
                            "Mascotas",
                            "Index",
                            "Mascotas",
                            new { area = "" },
                            new { @class = "nav-link" + activo("Mascotas") })
                    </li>

                    @if (User.IsInRole("Administrador"))
                    {
                        <li class="nav-item">
                            @Html.ActionLink(
                                "Adoptantes",
                                "Index",
                                "Adoptantes",
                                new { area = "" },
                                new { @class = "nav-link" + activo("Adoptantes") })
                        </li>

                        <li class="nav-item">
                            @Html.ActionLink(
                                "Solicitudes",
                                "Index",
                                "SolicitudesAdopcion",
                                new { area = "" },
                                new { @class = "nav-link" + activo("SolicitudesAdopcion") })
                        </li>
                    }

                </ul>

                <ul class="navbar-nav ms-auto">

                    @if (Request.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-light">
                                Hola, @User.Identity.Name
                            </span>
                        </li>

                        <li class="nav-item">
                            @using (Html.BeginForm(
                                "Logout",
                                "Account",
                                FormMethod.Post,
                                new { id = "logoutForm", @class = "d-inline" }))
                            {
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="nav-link btn btn-link text-light border-0">
                                    Cerrar sesión
                                </button>
                            }
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            @Html.ActionLink(
                                "Crear cuenta",
                                "Registro",
                                "Account",
                                new { area = "" },
                                new { @class = "nav-link" })
                        </li>

                        <li class="nav-item">
                            @Html.ActionLink(
                                "Iniciar sesión",
                                "Login",
                                "Account",
                                new { area = "" },
                                new { @class = "nav-link" })
                        </li>
                    }

                </ul>

            </div>
        </div>
    </nav>

    <main class="container flex-grow-1 body-content py-4">

        @Html.Partial("_Alertas")

        @RenderBody()

    </main>

    <footer class="py-3 mt-auto">
        <div class="container text-center text-muted small">
            &copy; @DateTime.Now.Year - Refugio de Animales
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    @RenderSection("scripts", required: false)

</body>
</html>
